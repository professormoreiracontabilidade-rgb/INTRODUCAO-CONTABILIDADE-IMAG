<!doctype html><html lang="pt-BR"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><meta name="theme-color" content="#06195b"><title>Aula 1 | Introdução à Contabilidade | Professor Moreira</title><style>
*{box-sizing:border-box}html,body{margin:0;min-height:100%;background:#06195b;color:#fff;font-family:system-ui,Arial,sans-serif}body{background:radial-gradient(circle at 20% 10%,#235de0,transparent 45%),linear-gradient(145deg,#06123d,#0c349c)}main{max-width:920px;min-height:100dvh;margin:auto;padding:12px;display:flex;flex-direction:column;gap:10px}.brand{text-align:center;color:#ffe44c;font-size:clamp(16px,3vw,24px);font-weight:950}.meta{display:flex;justify-content:space-between;font-size:clamp(14px,2.8vw,19px);font-weight:800;color:#ffe44c}.bar{height:8px;background:#ffffff33;border-radius:20px;overflow:hidden}.fill{height:100%;background:#ffe44c;width:3.33%}.stage{flex:1;min-height:0;display:flex;align-items:center;justify-content:center;background:#fff;border:3px solid #ffe44c;border-radius:18px;overflow:hidden;padding:5px}.stage img{display:block;max-width:100%;max-height:calc(100dvh - 190px);object-fit:contain;width:100%;height:auto;image-rendering:auto}.nav{position:sticky;bottom:0;display:flex;gap:8px;justify-content:space-between;background:#071d64;padding:8px 0 calc(8px + env(safe-area-inset-bottom))}.nav button{flex:1;border:0;border-radius:12px;padding:14px 6px;font-size:clamp(15px,3vw,22px);font-weight:900;background:#ffdf36;color:#071b5d;cursor:pointer}.nav button:disabled{opacity:.4}.nav .reset{background:#1b4ec5;color:#fff;border:2px solid #ffe44c}@media(orientation:landscape) and (max-height:550px){main{padding:5px;gap:4px}.brand{font-size:14px}.stage img{max-height:calc(100dvh - 125px)}.nav button{padding:8px}}@media(prefers-reduced-motion:no-preference){.fill{transition:width .2s}}button:focus-visible{outline:3px solid #fff}
</style></head><body><main><header class="brand">CURSO DE CONTABILIDADE PROFESSOR MOREIRA</header><div class="meta"><span id="counter">Imagem 1 de 30</span><span>AULA 1 • INTRODUÇÃO</span></div><div class="bar"><div class="fill" id="fill"></div></div><section class="stage" id="stage"><img id="picture" alt="Tela 1 de Introdução à Contabilidade"></section><nav class="nav"><button id="prev">⬅ Voltar</button><button id="reset" class="reset">↻ Reiniciar</button><button id="next">Avançar ➜</button></nav></main><script>
const images=["","","","","","","","","","","","","","","","","","","","","","","","","","","","","",""];const KEY='moreira_introducao_30_webp_v1';let pos=0;try{const v=Number(localStorage.getItem(KEY));if(Number.isInteger(v)&&v>=0&&v<images.length)pos=v}catch(e){}const picture=document.getElementById('picture'),counter=document.getElementById('counter'),fill=document.getElementById('fill'),prev=document.getElementById('prev'),next=document.getElementById('next');function show(n){pos=Math.max(0,Math.min(images.length-1,n));picture.src='data:image/webp;base64,'+images[pos];picture.alt='Tela '+(pos+1)+' de 30: Introdução à Contabilidade';counter.textContent='Imagem '+(pos+1)+' de '+images.length;fill.style.width=((pos+1)/images.length*100)+'%';prev.disabled=pos===0;next.disabled=pos===images.length-1;try{localStorage.setItem(KEY,String(pos))}catch(e){}window.scrollTo(0,0)}prev.onclick=()=>show(pos-1);next.onclick=()=>show(pos+1);document.getElementById('reset').onclick=()=>{if(confirm('Voltar para a primeira imagem?'))show(0)};document.addEventListener('keydown',e=>{if(e.key==='ArrowRight')show(pos+1);if(e.key==='ArrowLeft')show(pos-1)});let x=0;document.getElementById('stage').addEventListener('touchstart',e=>{x=e.changedTouches[0].screenX},{passive:true});document.getElementById('stage').addEventListener('touchend',e=>{let dx=e.changedTouches[0].screenX-x;if(Math.abs(dx)>65)show(pos+(dx<0?1:-1))},{passive:true});show(pos);
</script></body></html>
